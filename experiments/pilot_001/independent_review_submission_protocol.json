    "UNCERTAIN_cannot_bridge": true,
    "NOT_VISIBLE_cannot_bridge": true,
    "identity_no_or_uncertain_cannot_support_onset": true,
    "event_time": "current row decoded PTS",
    "previous_absent_time": "immediately previous row decoded PTS",
    "all_derived_onsets_preserved": true
