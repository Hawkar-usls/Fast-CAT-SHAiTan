{
  "schema": "Fast-CAT/PILOT-001/protocol/v1.1",
  "experiment_id": "PILOT_001",
  "title": "Open-video feline facial-response timing gate",
  "analysis_frozen_before_measurement": true,
  "protocol_amended_before_action_onset_measurement": true,
  "amendment": {
    "previous_schema": "Fast-CAT/PILOT-001/protocol/v1.0",
    "previous_protocol_sha256_canonical_json": "4acf5c298e23e60751469eb62d51ffadd8408aee8c2b488343b60ac8c9902e4d",
    "reason": "independent decoded-frame replay showed that stream-header FPS cannot define acquisition precision for the frozen sources; the hugging WebM advertises 120/1 while its decoded PTS ledger contains 50 frames with 58-67 ms adjacent gaps",
    "scope": "timing/uncertainty and claim-gate correction only; source order, primary actions, matching window, no-postselection policy and negative-outcome policy are unchanged",
    "biological_outcomes_seen_before_amendment": false,
    "action_labels_seen_before_amendment": false
  },
  "sources": [
    "commons_hugging_2019",
    "commons_tomcats_conflict_2020"
  ],
  "source_roles": {
    "commons_hugging_2019": "affiliative_candidate_primary",
    "commons_tomcats_conflict_2020": "non_affiliative_control"
  },
  "rapid_mimicry_window_ms": 1000,
  "timestamp_basis": "decoded video-frame presentation timestamps (best_effort_timestamp_time / PTS); avg_frame_rate and r_frame_rate are diagnostic only",
  "landmark_count": 48,
  "min_landmark_confidence": 0.5,
  "landmark_confidence_policy": "when a calibrated landmark-confidence channel is required by the admission path, missing confidence fails closed; body/object detection score is not landmark confidence",
  "min_event_confidence": 0.5,
  "primary_actions": [
    "EAD103",
    "EAD104"
  ],
  "secondary_actions": [
    "AU25",
    "AU26",
    "AU47",
    "EAD102",
    "EAD105"
  ],
  "allowed_event_sources": [
    "manual_catfacs_frame_review",
    "validated_fastcat_model"
  ],
  "manual_catfacs_frame_review_admission": {
    "reviewer_independent_of_model_rankings_before_label_freeze": true,
    "reviewer_or_protocol_must_justify_catfacs_action_coding_competence": true,
    "all_reviewed_labels_frozen_and_sha256_bound_before_model_comparison": true,
    "allowed_states_before_onset_derivation": [
      "ABSENT",
      "PRESENT",
      "UNCERTAIN",
      "NOT_VISIBLE"
    ],
    "onset_requires_immediately_previous_absent_then_first_present": true,
    "uncertain_or_not_visible_cannot_bridge_onset": true
  },
  "matching_policy": "earliest_unused_same_action_other_cat_forward_within_window",
  "selection_policy": "all_eligible_events_no_posthoc_dropping",
  "negative_outcome_policy": "no_match_is_valid_and_must_be_preserved",
  "precision_policy": {
    "latency_point_estimate": "(responder_onset_pts_s - signaller_onset_pts_s) * 1000",
    "onset_bracket": "for each first-visible onset require immediately previous reviewed ABSENT decoded frame: (previous_absent_pts_s, onset_pts_s]",
    "latency_acquisition_lower_bound": "(responder_previous_absent_pts_s - signaller_onset_pts_s) * 1000",
    "latency_acquisition_upper_bound": "(responder_onset_pts_s - signaller_previous_absent_pts_s) * 1000",
    "header_fps_role": "diagnostic_only",
    "global_nominal_frame_interval_bound_forbidden": true,
    "forbid_sub_frame_claim_without_sub_frame_measurement": true,
    "detector_or_reviewer_localization_uncertainty_is_additional": true
  },
  "model_selection": {
    "split_unit": "source_video_or_interaction_not_random_frames",
    "catgpt_role": "interpretable_autoregressive_baseline",
    "temporal_attention_role": "candidate_model_only_after_validation",
    "hyperparameter_optimization": "standard_GP_EI_allowed_on_frozen_validation_split",
    "forbidden_heuristics": [
      "digital_root_resonance",
      "tachyonic_filter_37",
      "post_hoc_action_selection",
      "post_hoc_source_dropping"
    ]
  },
  "landmark_detector_admission": {
    "scheme": "CatFLW/Finka-compatible 48 landmarks",
    "reference_detector_family": "ELD or equivalently validated 48-landmark detector",
    "reference_nme_iod_context": 2.91,
    "require_domain_review_on_each_admitted_open_video": true,
    "require_event_level_frame_review_for_pilot_001": true,
    "finite_48_point_geometry_is_not_accuracy_proof": true,
    "fixed_spatial_roi_identity_is_candidate_only": true,
    "body_detection_confidence_may_not_substitute_for_landmark_confidence": true
  },
  "claim_gate": {
    "INDEPENDENT_FRAME_LEVEL_ESTIMATE": [
      "raw_media_sha256_verified",
      "decoded_frame_pts_ledger_verified",
      "two_cat_identity_established_independently",
      "48_landmark_accuracy_or_admissible_manual_geometry_evidence_established",
      "facial_action_onsets_preregistered_independently_reviewed_and_sha256_bound",
      "previous_absent_plus_first_present_pts_brackets_verified",
      "deterministic_matching_replayed",
      "event_local_latency_acquisition_interval_reported",
      "negative_and_no_match_outcomes_preserved",
      "independent_verifier_pass"
    ]
  },
  "claim_ceiling": "This protocol amendment corrects timing and admission logic before any PILOT_001 action-onset labels or biological latency result exist. It does not establish landmark accuracy, CatFACS actions, action onset, mimicry, delta-t, or a population-level feline reaction time."
}
